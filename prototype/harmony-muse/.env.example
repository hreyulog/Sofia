# MiniMax
MINIMAX_TOKEN_FILE=/absolute/path/to/minimaxtoken.txt
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_URL=https://api.minimaxi.com/v1/text/chatcompletion_v2
MINIMAX_PROXY_HOST=127.0.0.1
MINIMAX_PROXY_PORT=8790

# Agent runtime
HARMONY_AGENT_HOST=127.0.0.1
HARMONY_AGENT_PORT=8791
MINIMAX_PLAN_URL=http://127.0.0.1:8790/plan

# Development HarmonyBridge backend (HDC + UITest)
HARMONY_HDC=/path/to/hdc
HARMONY_TARGET=<hdc-target-of-spare-phone>
HARMONY_DEVICE_LABEL=Nova 15 Pro
HARMONY_EXECUTOR_BUNDLE=com.hreyulog.harmonyagent.executor
HARMONY_EXECUTOR_ABILITY=EntryAbility
HARMONY_WORKDIR=/tmp/harmony-muse
HARMONY_WINDOWS_WORKDIR=C:\Temp\harmony-muse
MINIMAX_PROXY_URL=http://127.0.0.1:8790

# Relay
HARMONY_RELAY_HOST=127.0.0.1
HARMONY_RELAY_PORT=8787
HARMONY_AGENT_URL=http://127.0.0.1:8791/execute
